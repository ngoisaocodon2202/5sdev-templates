{
  "name": "5sdev-templates",
  "version": "1.0.0",
  "private": true,
  "description": "5S DEV.TEMPLATES — Hệ thống thư viện và quản lý 1.000+ Website UI Templates đa ngành nghề cho nền tảng 5sdev.vn",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node --max-old-space-size=6144 ./node_modules/typescript/bin/tsc --noEmit && node --max-old-space-size=6144 ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview --port 4173",
    "typecheck": "node --max-old-space-size=6144 ./node_modules/typescript/bin/tsc --noEmit",
    "generate:batch": "node scripts/generate-templates/index.mjs",
    "validate": "node scripts/validate-templates/index.mjs",
    "build:catalog": "node scripts/build-templates/index.mjs",
    "test": "node scripts/validate-templates/index.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
